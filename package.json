{
  "name": "poe-manager-extension",
  "private": true,
  "version": "0.1.0",
  "description": "poe-manager для pathofexile.com/trade: закладки поисков, история, закреплённые предметы, пересчёт цен",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "build:fast": "node scripts/build.mjs",
    "dev": "vite --config vite.config.ts",
    "preview:mock": "vite --config vite.config.ts --open /dev/trade-mock.html",
    "sync:design-system": "node scripts/sync-design-system.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && node scripts/check-tokens.mjs && vitest run",
    "package": "node scripts/build.mjs --zip"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.68.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/chrome": "^0.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
